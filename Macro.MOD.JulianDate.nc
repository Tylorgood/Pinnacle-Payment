%
O00517 (JULIAN DATE ENGRAVE) 
(REV X4) 
(11.10.2023 MRT)


M06 T1 
M03 S10000 
G54 G00 G90 X0 Y0 
G43 H01 Z0.1 

G103 P1 (BLOCK LOOKAHEAD) 


(YEAR) 
#100= FIX[ #3011 / 10000 ] 

(MONTH) 
#101= FIX[ #3011 / 100 ] - [ #100 * 100 ] 

(DAY) 
#102= #3011 - [ #100 * 10000 ] - [ #101 * 100 ] 

(LEAP YEAR LOGIC)
(FEB= 28 OR 29 DAYS? SETS AS #104)
#103= #100 MOD 4 
#104= 28 
IF [#103EQ0]THEN #104= 29 

(ADD 2000 TO YEAR DATE TO MAKE 4 DIGIT)
#100= #100 + 2000 

(SETS #105 TO THE CURRENT DAY OF YEAR)
(#101 IS MONTH, #102 IS CURRENT DAY OF MONTH, #104 IS DAYS IN FEB)
(JAN) IF [ #101 EQ 1 ] THEN #105= #102
(FEB) IF [ #101 EQ 2 ] THEN #105= 31+#102
(MAR) IF [ #101 EQ 3 ] THEN #105= 31+#104+#102
(APR) IF [ #101 EQ 4 ] THEN #105= 62+#104+#102
(MAY) IF [ #101 EQ 5 ] THEN #105= 92+#104+#102
(JUN) IF [ #101 EQ 6 ] THEN #105= 123+#104+#102
(JUL) IF [ #101 EQ 7 ] THEN #105= 153+#104+#102
(AUG) IF [ #101 EQ 8 ] THEN #105= 184+#104+#102
(SEP) IF [ #101 EQ 9 ] THEN #105= 215+#104+#102
(OCT) IF [ #101 EQ 10 ] THEN #105= 245+#104+#102
(NOV) IF [ #101 EQ 11 ] THEN #105= 276+#104+#102
(DEC) IF [ #101 EQ 12 ] THEN #105= 306+#104+#102


G90 X0 Y-0.5 
G187 P3 

#599= #100 (SET 599 TO YEAR) 
(ENGRAVES 4 DIGIT YEAR)
G47 P1 (####) I0 J0.1 R0.1 Z-0.002 F80. E40. 

#599= #105 (SET 599 TO JULIAN DAY OF YEAR, #105) 
(ENGRAVES JULIAN DATE, DAYS)
G47 P1 (###) I0 J0.1 R0.1 Z-0.002 F80. E40. 


