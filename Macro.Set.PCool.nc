
%
O00103 (AUTO PCOOL SET, HAAS VMC) 
(PROBE TOOLS,THEN RUN THIS PROGRAM) 
(TO AUTO SET PCOOL POSITIONS) 

(*** ENTER USER DEFINED VALUES ***) 
#125= 1. (PCOOL SHIFT AMOUNT,INCHES) 
#127= 40 (# TOOLS TO SET, 1-200) 
(*** END USER VALUES ***) 

(PROGRAM RUNS IN INCH OR METRIC MODE) 

(ADJUST #125 VALUE ABOVE) 
(TO SHIFT PCOOL POSIT FROM DEFAULT) 
(1.0 = 1 IN ABOVE TIP OF TOOL) 

(SETS 40 TOOLS BY DEFAULT) 
(ADJUST #127, ABOVE) 
(TO SET UP TO 200 TOOLS) 
(MORE TOOLS = LONGER TIME TO) 
(RUN ON CLASSIC CONTROLS) 

(WORKS WITH PROBING ONLY,) 
(POSITIVE TOOL LENGTHS) 

(********************************) 
(2.15.17 TERRYBERRY) 

(*** MACRO DEFINITIONS ***) 
(#125 = USER MACRO,PCOOL TARGET ADJUST) 
(#127 = NUM TOOLS TO SET) 
(#179 = METRIC CONVERSION) 
(#500-534 = USER MACROS, SPIGOT POSITS) 
(#2001-2200 = TOOL LENG OFFSETS, 1-200) 
(#2201-2400 = TOOL LENGTH WEAR, 1-200) 
(#3401-3600 = PCOOL POSIT, OFFSETS 1-200) 
(*** END DEFINITIONS ***) 

G103 P1 (BLOCK LOOKAHEAD) 


(CHECK IN/MM MODE) 
(#6009 IS SETTING 9) 
IF [ #6009 EQ 1 ] GOTO9 
#179= 1 (IN MODE) 
M99 P10 

N9 
#179= 25.4 (METRIC CONVERSION) 


N10 

(***  INCH PCOOL POSITIONS, 0-34 ***) 
(SPIGOT POSIT = TOOL LENGTH IN/MM) 
(MUST BE SET FOR EACH MACHINE) 
(0) #500= 0 
(1) #501= 0 
(2) #502= 0 
(3) #503= 0 
(4) #504= 1.5 
(5) #505= 1.7 
(6) #506= 2.0 
(7) #507= 2.2 
(8) #508= 2.5 
(9) #509= 2.7 
(10) #510= 3.0 
(11) #511= 3.2 
(12) #512= 3.6 
(13) #513= 4.0 
(14) #514= 4.3 
(15) #515= 4.5 
(16) #516= 4.9 
(17) #517= 5.3 
(18) #518= 5.7 
(19) #519= 6.1 
(20) #520= 6.5 
(21) #521= 6.9 
(22) #522= 7.3 
(23) #523= 7.7 
(24) #524= 8.4 
(25) #525= 8.9 
(26) #526= 9.3 
(27) #527= 9.9 
(28) #528= 10.5 
(29) #529= 11.0 
(30) #530= 11.7 
(31) #531= 12.4 
(32) #532= 13.1 
(33) #533= 13.8 
(34) #534= 14.7 
(*** END SPIGOT LENGTHS ***) 


(*** WRITE PCOOL OFFSETS ***) 
(OFFSETS 1-200) 
#100= 0 (ACTIVE OFFSET COUNTER) 
#101= 0 (ACTIVE TOOL LENGTH) 
#102= 0 
#103= 0 


(WHILE LOOP 1) 
(LOOPS UNTIL MAX T # REACHED, #127) 
WH [ #100 LT #127 ] DO1 
#100= #100 + 1 (COUNTER) 


(ALARM IF TOOL SET MANUALLY) 
(PROBED TOOLS HAVE POS GAGE LNGTH) 
IF [ #[ 2000 + #100 ] LT 0 ] #3000= 1 (MACRO ONLY COMPATIBLE WITH PROBE) 

G103 P1 



IF [ #[ 2000 + #100 ] GE [ #534 * #179 ] ] THEN #[ 3400 + #100 ]= 34 (MAX SPIGOT) 
IF [ #[ 2000 + #100 ] GE [ #534 * #179 ] ] GOTO99 

IF [ #[ 2000 + #100 ] LT [ #501 * #179 ] ] THEN #[ 3400 + #100 ]= 0 (MIN SPIGOT) 
IF [ #[ 2000 + #100 ] LT [ #501 * #179 ] ] GOTO99 

#105= 0 

(WHILE LOOP 2,) 
(RUNS WITHIN WH LOOP 1) 
(FOR EACH TOOL OFFSET) 
(LOOPS 34 X, ONCE PER PCOOL POSIT) 
WH [ #105 LT 34 ] DO2 
#105= #105 + 1 (0-34 COUNTER) 


IF [ #[ 2000 + #100 ] GE [ [ #[ 500 + #105 ] + #125 ] * #179 ] ] GOTO98 
#[ 3400 + #100 ]= #105 (WRITE SPIGOT NUMBER TO OFFSET) 
#105= 34 
N98 
IF [ #[ 2000 + #100 ] GE [ #[ 500 + #105 ] * #179 ] ] THEN #[ 3400 + #100 ]= 34 (MAX SPIGOT) 
END2 

N99 
END1 
(*** END OFFSET WRITE ***) 



M30 
%
